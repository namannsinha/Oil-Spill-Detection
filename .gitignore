*.pt
*.pth
*.onnx
*.h5
*.keras
*.ckpt
*.safetensors

# Keep model directory structure but ignore weights
models/*
!models/.gitkeep

# ==========================================
# Dataset / Raw Data
# ==========================================
# Ignore large datasets
data/raw/
data/processed/
data/datasets/

# Sentinel / satellite imagery
*.tif
*.tiff
*.jp2
*.nc
*.hdf
*.h5

# AIS / environmental downloaded data
data/environment/
data/ais/

# Temporary downloaded files
*.zip
*.tar
*.tar.gz

# ==========================================
# Generated Outputs
# ==========================================
outputs/

# Keep output folders but not generated files
!outputs/.gitkeep

