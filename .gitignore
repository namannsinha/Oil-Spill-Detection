# ==========================================
outputs/evaluation/predictions/
outputs/evaluation/probabilities/
outputs/evaluation/threshold_analysis/
outputs/evaluation/visualizations/

outputs/hindcast/predictions/
outputs/hindcast/visualizations/

# ==========================================
# Generated CSV / Reports
